# ─────────────────────────────────────────────────────────────────
# Emowave — Variables de entorno del backend (Producción)
# ─────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena cada valor
# 3. NUNCA subas el archivo .env al repositorio
# ─────────────────────────────────────────────────────────────────

PORT=3000
# production en el servidor: exige secretos fuertes y desactiva comodidades de desarrollo
NODE_ENV=production
# Orígenes del frontend separados por comas; el primero se usa para volver desde Spotify
FRONTEND_URL=
# true imprime cada consulta SQL (incluye datos de usuarios): solo para depurar en local
SQL_DEBUG=false

# ─── SEGURIDAD ───────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios cada uno. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
BCRYPT_ROUNDS=

ACCESS_TOKEN_EXPIRES=
REFRESH_TOKEN_EXPIRES=
COOKIE_SECURE=
COOKIE_SAMESITE=
COOKIE_DOMAIN=

# ─── CORREO ELECTRÓNICO (SMTP) ───────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── LIMITADORES Y EXPIRACIONES ──────────────────────────────────
OTP_EXPIRATION_MINUTES=
RESET_PASSWORD_EXPIRATION_MINUTES=

MAX_LOGIN_ATTEMPTS=
OTP_MAX_ATTEMPTS=
ACCOUNT_LOCK_MINUTES=

# ─── ADMINISTRADOR ───────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_NAME=
# Mínimo 12 caracteres; si es más corta, el administrador no se crea
ADMIN_PASSWORD=

# ─── ANTHROPIC (IA) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
# online usa la API de Claude; offline usa el simulador local sin costo
AI_MODE=online

# ─── SPOTIFY ─────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Debe coincidir con la URL registrada en el panel de Spotify; pasa por el frontend:
#   http://<tu-host>:3031/api/auth/spotify/callback
SPOTIFY_REDIRECT_URI=
